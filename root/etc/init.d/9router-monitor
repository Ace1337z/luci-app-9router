#!/bin/sh /etc/rc.common

START=96
STOP=09
USE_PROCD=1

CONFIG=9router

start_service() {
	local monitor

	config_load "$CONFIG"
	config_get_bool monitor main monitor 1
	[ "$monitor" = 1 ] || return 0

	procd_open_instance sampler
	procd_set_param command /bin/sh /usr/libexec/9router/monitor.sh
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_set_param nice 10
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}
